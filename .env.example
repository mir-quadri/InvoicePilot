# InvoicePilot — copy to .env for a LIVE PayPal sandbox demo only.
# Default (no .env): the mock sandbox is used and NO network call to PayPal happens.
# Never put live/production PayPal credentials here. Sandbox only. Test accounts only.

# PAYPAL_MODE=mock            # mock (default) | live-sandbox
# PAYPAL_CLIENT_ID=           # PayPal Developer sandbox app client ID (sandbox only)
# PAYPAL_CLIENT_SECRET=       # PayPal Developer sandbox app secret (sandbox only)
# PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# PORT=3000

# Optional hosted-model drafting (NOT configured in this build):
# AI_DRAFT_ENDPOINT=https://example-model-endpoint.example/v1/draft
# AI_DRAFT_API_KEY=           # only if the endpoint requires one
# Without these, the deterministic local drafting engine is used. The hosted
# provider fails loudly (no silent fallback) if its endpoint errors.
